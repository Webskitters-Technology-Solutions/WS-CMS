FROM node:22-alpine
LABEL org.opencontainers.image.title="WTS CMS Admin" \
  org.opencontainers.image.vendor="Webskitters Technology Solutions Pvt. Ltd." \
  org.opencontainers.image.url="https://www.webskitters.com"
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile=false
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
RUN pnpm --filter @wts-cms/shared build && pnpm --filter @wts-cms/admin build
EXPOSE 3001
CMD ["pnpm", "--filter", "@wts-cms/admin", "start"]
