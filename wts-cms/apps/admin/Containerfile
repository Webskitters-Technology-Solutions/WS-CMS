FROM node:22-alpine
LABEL org.opencontainers.image.title="WTS CMS Admin" \
  org.opencontainers.image.vendor="Webskitters Technology Solutions Pvt. Ltd." \
  org.opencontainers.image.url="https://www.webskitters.com"
WORKDIR /app
RUN corepack enable
COPY . .
ARG NEXT_PUBLIC_API_BASE_URL
ARG ADMIN_SITE_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV ADMIN_SITE_URL=${ADMIN_SITE_URL}
RUN pnpm install --frozen-lockfile=false && pnpm build:admin
EXPOSE 3001
CMD ["pnpm", "--filter", "@wts-cms/admin", "start"]
