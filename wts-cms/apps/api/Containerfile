FROM node:22-alpine
LABEL org.opencontainers.image.title="WTS CMS API" \
  org.opencontainers.image.vendor="Webskitters Technology Solutions Pvt. Ltd." \
  org.opencontainers.image.url="https://www.webskitters.com"
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile=false && pnpm build:api
EXPOSE 4000
CMD ["pnpm", "--filter", "@wts-cms/api", "start"]
