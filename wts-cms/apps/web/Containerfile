FROM node:22-alpine
LABEL org.opencontainers.image.title="WTS CMS Web" \
  org.opencontainers.image.vendor="Webskitters Technology Solutions Pvt. Ltd." \
  org.opencontainers.image.url="https://www.webskitters.com"
WORKDIR /app
RUN corepack enable
COPY . .
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SITE_URL
ARG PUBLIC_SITE_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV PUBLIC_SITE_URL=${PUBLIC_SITE_URL}
RUN pnpm install --frozen-lockfile=false && pnpm build:web
EXPOSE 3000
CMD ["pnpm", "--filter", "@wts-cms/web", "start"]
