{
  "name": "wts-cms-web-tsconfig",
  "author": "Webskitters Technology Solutions Pvt. Ltd.",
  "homepage": "https://www.webskitters.com",
  "extends": "../../packages/config/typescript/base.json",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
