{
  "name": "wts-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WTS CMS - Enterprise-ready lightweight CMS starter platform powered by Webskitters.",
  "author": "Webskitters Technology Solutions Pvt. Ltd.",
  "homepage": "https://www.webskitters.com",
  "license": "MIT",
  "scripts": {
    "dev": "corepack pnpm -r --parallel --filter @wts-cms/api --filter @wts-cms/web --filter @wts-cms/admin dev",
    "dev:api": "corepack pnpm --filter @wts-cms/api dev",
    "dev:web": "corepack pnpm --filter @wts-cms/web dev",
    "dev:admin": "corepack pnpm --filter @wts-cms/admin dev",
    "build": "corepack pnpm -r --filter './packages/**' build && corepack pnpm build:api && corepack pnpm build:web && corepack pnpm build:admin",
    "build:api": "corepack pnpm --filter @wts-cms/api build",
    "build:web": "corepack pnpm --filter @wts-cms/web build",
    "build:admin": "corepack pnpm --filter @wts-cms/admin build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "typecheck": "corepack pnpm --filter @wts-cms/shared build && corepack pnpm -r typecheck",
    "test": "corepack pnpm --filter @wts-cms/api test",
    "test:api": "corepack pnpm --filter @wts-cms/api test",
    "test:e2e": "playwright test",
    "test:full": "corepack pnpm headers:check && corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm build && corepack pnpm test:e2e",
    "seed": "corepack pnpm --filter @wts-cms/api seed",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "db:export-demo": "tsx scripts/export-demo-database.ts",
    "db:import-demo": "tsx scripts/import-demo-database.ts",
    "headers:check": "tsx scripts/check-headers.ts",
    "podman:up": "podman compose -f infra/podman/podman-compose.yml up -d",
    "podman:down": "podman compose -f infra/podman/podman-compose.yml down",
    "podman:logs": "podman compose -f infra/podman/podman-compose.yml logs -f",
    "podman:build": "podman compose -f infra/podman/podman-compose.yml build",
    "podman:prod:up": "podman compose -f infra/podman/podman-compose.prod.yml up -d",
    "podman:prod:down": "podman compose -f infra/podman/podman-compose.prod.yml down",
    "clean": "rimraf node_modules apps/*/.next apps/*/dist packages/*/dist coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.15.3",
    "@wts-cms/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "eslint": "^10.3.0",
    "eslint-config-next": "^15.3.1",
    "globals": "^17.6.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.31.0"
  },
  "packageManager": "pnpm@10.10.0"
}
